<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' – ' + s.site_name : 'Ringen in Köln-Ehrenfeld – ' + s.site_name + ' | Training für Kinder, Jugend und Erwachsene' %></title>
<meta name="description" content="<%= typeof description !== 'undefined' && description ? description : s.meta_description %>">
<link rel="canonical" href="<%= s.base_url %><%= path %>">
<meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, follow' : 'index, follow' %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="<%= s.site_name %>">
<meta property="og:title" content="<%= title ? title : 'Ringen in Köln-Ehrenfeld – ' + s.site_name %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : s.meta_description %>">
<meta property="og:url" content="<%= s.base_url %><%= path %>">
<meta property="og:image" content="<%= s.base_url %><%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (s.hero_image || '/assets/img/mannschaft-duisdorf-2026.jpg') %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0B1B4A">
<link rel="icon" href="/assets/img/wappen.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/wappen.png">
<link rel="preload" href="/assets/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
