<%- include('../partials/head') %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsClub",
      "@id": s.base_url + "/#verein",
      "name": s.legal_name,
      "alternateName": s.site_name,
      "url": s.base_url + "/",
      "logo": s.base_url + "/assets/img/wappen.png",
      "description": s.meta_description,
      "sport": "Ringen",
      "foundingDate": "1976",
      "telephone": "+" + s.phone_link.replace(/^\+/, ''),
      "email": s.email,
      "sameAs": s.instagram ? ["https://www.instagram.com/" + s.instagram + "/"] : [],
      "address": { "@type": "PostalAddress", "streetAddress": s.address.split('\n')[0] || '', "postalCode": (s.address.split('\n')[1] || '').split(' ')[0], "addressLocality": "Köln", "addressRegion": "NRW", "addressCountry": "DE" },
      "openingHoursSpecification": groups.flatMap(g => g.times.map(t => ({ "@type": "OpeningHoursSpecification", "dayOfWeek": ({Montag:"Monday",Dienstag:"Tuesday",Mittwoch:"Wednesday",Donnerstag:"Thursday",Freitag:"Friday",Samstag:"Saturday",Sonntag:"Sunday"})[t.weekday], "opens": t.time_from, "closes": t.time_to, "description": (t.label || g.name) + ", " + t.location })))
    },
    ...(nextMatch ? [{
      "@type": "SportsEvent",
      "name": nextMatch.home + " – " + nextMatch.away + " (" + nextMatch.liga + (nextMatch.kampftag ? ", " + nextMatch.kampftag : "") + ")",
      "startDate": nextMatch.date + (nextMatch.time ? "T" + nextMatch.time + ":00+01:00" : ""),
      "eventStatus": "https://schema.org/EventScheduled",
      "sport": "Ringen",
      "homeTeam": { "@type": "SportsTeam", "name": nextMatch.home },
      "awayTeam": { "@type": "SportsTeam", "name": nextMatch.away },
      "organizer": { "@id": s.base_url + "/#verein" }
    }] : [])
  ]
}) %>
</script>
</head>
<body>
<a class="skip" href="#aktuelles">Zum Inhalt springen</a>
<%- include('../partials/header') %>

<main>

<section class="hero" id="start">
<div class="wrap">
<div class="hero-text">
<span class="eyebrow"><%= s.eyebrow %></span>
<h1><%- util.escapeHtml(s.hero_title).replace(/\n/g, '<br>') %><br><span class="akzent"><%= s.hero_accent %></span></h1>
<p><%= s.hero_text %></p>
<div class="hero-actions">
<a class="btn btn-primary" href="#mitmachen">Probetraining anfragen</a>
<a class="btn btn-outline" href="#training">Trainingszeiten</a>
</div>
</div>
<div class="hero-matte">
<% if (s.hero_image) { %>
<img src="<%= s.hero_image %>" alt="" style="width: 100%; max-width: 520px; aspect-ratio: 1; object-fit: cover; border: 3px solid #0B1B4A">
<% } else { %>
<div class="matte">
<svg viewBox="0 0 400 400" aria-hidden="true">
<circle cx="200" cy="200" r="194" fill="#DCE5F7" stroke="#0B1B4A" stroke-width="3"/>
<circle cx="200" cy="200" r="168" fill="none" stroke="#1B3FA0" stroke-width="30"/>
<circle cx="200" cy="200" r="152" fill="none" stroke="#0B1B4A" stroke-width="2"/>
<circle cx="200" cy="200" r="140" fill="#FFFFFF" stroke="#0B1B4A" stroke-width="3"/>
</svg>
<img src="/assets/img/wappen.png" alt="" width="300" height="327">
</div>
<% } %>
</div>
</div>
</section>

<section class="aktuelles" id="aktuelles" style="border-top: 3px solid #0B1B4A">
<div class="wrap section">
<div class="section-head">
<h2>Aktuelles</h2>
<a class="link" href="/aktuelles">Alle Berichte</a>
</div>
<% if (posts.length) { %>
<div class="news-grid">
<% for (const post of posts) { %><%- include('../partials/post-card', { post }) %><% } %>
</div>
<% } else { %>
<p class="muted">Noch keine Beiträge.</p>
<% } %>
</div>
</section>

<section class="training" id="training" style="border-top: 3px solid #0B1B4A">
<div class="wrap section">
<div class="intro">
<h2>Training</h2>
<p><%= s.training_intro %></p>
</div>
<div class="training-grid">
<% for (const g of groups) { %>
<div class="karte">
<h3><%= g.name %></h3>
<% if (g.subtitle) { %><p class="muted"><%= g.subtitle %></p><% } %>
<div class="zeiten">
<% for (const t of g.times) { %>
<div class="zeit">
<% if (t.label) { %><strong><%= t.label %></strong><span><%= t.weekday %>, <%= t.time_from %> bis <%= t.time_to %> Uhr</span><% } else { %><strong><%= t.weekday %>, <%= t.time_from %> bis <%= t.time_to %> Uhr</strong><% } %>
<span class="muted"><%= t.location %></span>
</div>
<% } %>
</div>
<% if (g.note) { %><p class="muted"><%= g.note %></p><% } %>
</div>
<% } %>
</div>
</div>
</section>

<section class="verein" id="verein">
<div class="wrap">
<div class="jahr">
<div class="zahl">1976</div>
<div class="sub">Gegründet in Köln-Ehrenfeld</div>
</div>
<div class="verein-text">
<h2>Die Geschichte unseres Vereins</h2>
<p><%= s.history_lead %></p>
<%- util.formatText(s.history_text).replace(/<p>/g, '<p class="muted">') %>
</div>
<div class="verein-grid">
<div class="verein-karte">
<h3>Größte Erfolge</h3>
<% for (const line of util.lines(s.successes)) { const [y, t] = line.split('|'); %>
<div class="erfolg"><span><%= y %></span><span class="muted"><%= t %></span></div>
<% } %>
</div>
<div class="verein-karte">
<h3>Hier fing es an</h3>
<p class="muted">Ringer, die in Ehrenfeld begonnen haben:</p>
<p><strong><%- util.lines(s.alumni).map(util.escapeHtml).join('<br>') %></strong></p>
<% if (s.alumni_note) { %><p class="muted"><%= s.alumni_note %></p><% } %>
</div>
<div class="verein-karte">
<h3>Trainerteam</h3>
<% for (const r of trainerRoles) { %>
<p><span class="rolle"><%= r.role %>:</span><br><strong><%- r.names.map(util.escapeHtml).join('<br>') %></strong></p>
<% } %>
<% if (s.trainer_note) { %><p class="muted"><%= s.trainer_note %></p><% } %>
</div>
</div>
</div>
</section>

<section class="kaempfe-sektion" id="kaempfe">
<div class="wrap section">
<div class="section-head">
<h2>Kämpfe &amp; Ergebnisse</h2>
<span class="stand"><%= s.season_label %> · Stand: <%= s.results_stand %></span>
</div>

<% if (nextMatch) { %>
<div class="naechster">
<div class="naechster-datum">
<span class="eyebrow">Nächster Kampf<%= nextMatch.kampftag ? ' · ' + nextMatch.kampftag : '' %></span>
<span class="datum"><%= util.formatDateWd(nextMatch.date) %></span>
<span class="info"><%= nextMatch.time ? nextMatch.time + ' Uhr' : '' %><%= nextMatch.time && nextMatch.location ? ' · ' : '' %><%= nextMatch.location %></span>
</div>
<div class="paarung"><span><%= nextMatch.home %></span><span class="vs">vs</span><span><%= nextMatch.away %></span></div>
</div>
<% } %>

<% if (lastMatch) { const own = lastMatch.home === ownTeam; %>
<div class="letzter">
<div class="letzter-head">
<div>
<span class="eyebrow">Letzter Kampf<%= lastMatch.kampftag ? ' · ' + lastMatch.kampftag : '' %> · <%= util.formatDateWd(lastMatch.date) %><%= lastMatch.location ? ' · ' + lastMatch.location : '' %></span><br>
<span class="titel"><%= lastMatch.home %> – <%= lastMatch.away %></span>
</div>
<div class="ergebnis"><span class="<%= own ? 'heim' : '' %>"><%= lastMatch.home_score %></span><span class="trenner">:</span><span class="<%= own ? '' : 'heim' %>"><%= lastMatch.away_score %></span></div>
</div>
<% if (bouts.length) { %>
<div class="scroll">
<table class="kaempfe">
<thead><tr><th scope="col">Klasse</th><th scope="col"><%= lastMatch.home %></th><th scope="col"><%= lastMatch.away %></th><th scope="col">Wertung</th><th scope="col">Punkte</th></tr></thead>
<tbody>
<% for (const b of bouts) { const hw = b.home_points > b.away_points, aw = b.away_points > b.home_points; %>
<tr><td class="klasse"><%= b.weight_class %></td><td class="<%= hw ? 'sieg' : '' %>"><%= b.home_wrestler || '' %><% if (!b.home_wrestler) { %><span class="muted">kampflos</span><% } %></td><td class="<%= aw ? 'sieg' : '' %>"><%= b.away_wrestler || '' %><% if (!b.away_wrestler) { %><span class="muted">kampflos</span><% } %></td><td class="muted"><%= b.result_type %></td><td class="pkt"><%= b.home_points %> : <%= b.away_points %></td></tr>
<% } %>
</tbody>
</table>
</div>
<p class="small">G = griechisch-römisch, F = Freistil · SS Schultersieg, TÜ technische Überlegenheit, PS Punktsieg, AS Aufgabesieg, KL kampflos<%= lastMatch.referee ? ' · Kampfrichter: ' + lastMatch.referee : '' %></p>
<% } %>
</div>
<% if (others.length) { %>
<div class="weitere">
<span class="eyebrow">Weitere Ergebnisse<%= lastMatch.kampftag ? ' · ' + lastMatch.kampftag : '' %> <%= lastMatch.liga %></span>
<div class="weitere-grid">
<% for (const o of others) { %>
<div><span><% if (o.home_score > o.away_score) { %><strong><%= o.home %></strong><% } else { %><%= o.home %><% } %> – <% if (o.away_score > o.home_score) { %><strong><%= o.away %></strong><% } else { %><%= o.away %><% } %></span><span><%= o.home_score %> : <%= o.away_score %></span></div>
<% } %>
</div>
</div>
<% } %>
<% } %>
</div>
</section>

<% if (league.length) { %>
<section class="tabelle" id="tabelle">
<div class="wrap section">
<div class="section-head">
<h2>Tabelle <%= s.season_label %></h2>
<span class="stand"><%= s.table_stand %></span>
</div>
<div class="tabelle-box">
<table class="liga">
<thead><tr><th scope="col">Pl.</th><th scope="col">Mannschaft</th><th scope="col" class="c">K</th><th scope="col" class="c">S</th><th scope="col" class="c">U</th><th scope="col" class="c">N</th><th scope="col" class="r">Wertung</th><th scope="col" class="r">Punkte</th></tr></thead>
<tbody>
<% for (const r of league) { %>
<tr<%= r.is_own ? ' class="rce"' : '' %>><td class="pl"><%= r.position %></td><td class="team"><% if (r.is_own) { %><img src="/assets/img/wappen.png" alt="" width="300" height="327"><span><%= r.team %></span><% } else { %><%= r.team %><% } %></td><td class="c"><%= r.played %></td><td class="c"><%= r.won %></td><td class="c"><%= r.drawn %></td><td class="c"><%= r.lost %></td><td class="r<%= r.is_own ? '' : ' wert' %>"><%= r.points_for %> : <%= r.points_against %></td><td class="r pkt"><%= r.table_points %></td></tr>
<% } %>
</tbody>
</table>
</div>
<div class="tabelle-foot">
<p class="small">K Kämpfe · S Siege · U Unentschieden · N Niederlagen · Quelle: Ringerverband NRW e.V.</p>
<% if (s.league_url) { %><a class="btn btn-outline btn-sm" href="<%= s.league_url %>" target="_blank" rel="noopener">Alle Ergebnisse beim Verband</a><% } %>
</div>
</div>
</section>
<% } %>

<section class="mitmachen" id="mitmachen">
<div class="wrap section">
<div class="intro">
<h2>Mach mit auf der Matte</h2>
<p>In drei Schritten bist du dabei.</p>
</div>
<div class="schritte">
<div class="schritt"><span class="nr">1</span><h3>Melde dich</h3><p>Schreib uns kurz oder ruf an. Nenne uns Alter und Vorerfahrung, dann sagen wir dir, welche Gruppe passt.</p></div>
<div class="schritt"><span class="nr">2</span><h3>Probetraining</h3><p>Komm zum Schnuppern in die Halle und probier das Ringen in Ruhe aus.</p></div>
<div class="schritt"><span class="nr">3</span><h3>Werde Mitglied</h3><p>Gefällt es dir, füllst du den Aufnahmeantrag aus. <%= s.membership_note %></p></div>
</div>
<div><a class="btn btn-gelb" href="#kontakt">Kontakt aufnehmen</a></div>
</div>
</section>

<% if (sponsors.length) { %>
<section class="sponsoren" id="sponsoren">
<div class="wrap section">
<div class="intro">
<h2>Unsere Sponsoren</h2>
<p><%= s.sponsor_intro %></p>
</div>
<div class="sponsor-grid">
<% for (const sp of sponsors) { %>
<div class="sponsor"><% if (sp.url) { %><a href="<%= sp.url %>" target="_blank" rel="noopener"><% } %><% if (sp.logo) { %><img src="<%= sp.logo %>" alt="<%= sp.name %>" loading="lazy"><% } else { %><span><%= sp.name %></span><% } %><% if (sp.url) { %></a><% } %></div>
<% } %>
</div>
<p><strong>Sponsor werden?</strong> Schreib uns an <a href="mailto:<%= s.email %>"><%= s.email %></a>.</p>
</div>
</section>
<% } %>

<section class="kontakt" id="kontakt">
<div class="wrap section">
<h2>Kontakt</h2>
<div class="kontakt-grid">
<div class="kontakt-block"><span class="label">Trainingshallen</span><span><%- util.escapeHtml(s.halls).replace(/\n/g, '<br>') %></span></div>
<div class="kontakt-block"><span class="label">Ansprechperson</span><span><%= s.contact_name %><br><%= s.site_name %><br><%- util.escapeHtml(s.address).replace(/\n/g, '<br>') %><br><a href="tel:<%= s.phone_link %>"><%= s.phone %></a><br><a href="mailto:<%= s.email %>"><%= s.email %></a></span></div>
<% if (s.instagram) { %>
<div class="kontakt-block"><span class="label">Online</span><a class="insta" href="https://www.instagram.com/<%= s.instagram %>/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram: @<%= s.instagram %></span></a></div>
<% } %>
</div>
</div>
</section>

</main>
<%- include('../partials/footer') %>
