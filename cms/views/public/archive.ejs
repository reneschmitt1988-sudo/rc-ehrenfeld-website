<%- include('../partials/head', { description: 'Berichte, Vorberichte und Neuigkeiten vom ' + s.site_name }) %>
</head>
<body>
<%- include('../partials/header') %>
<main>
<section>
<div class="wrap section">
<h1 style="font-size: clamp(44px, 6vw, 72px)">Aktuelles</h1>
<% if (posts.length) { %>
<div class="news-grid">
<% for (const post of posts) { %><%- include('../partials/post-card', { post }) %><% } %>
</div>
<% } else { %><p class="muted">Noch keine Beiträge.</p><% } %>
</div>
</section>
</main>
<%- include('../partials/footer') %>
