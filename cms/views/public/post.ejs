<%- include('../partials/head', { description: post.teaser, ogType: 'article', ogImage: post.image }) %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.title,
  "datePublished": post.date,
  "dateModified": post.updated_at,
  "image": post.image ? [s.base_url + post.image] : undefined,
  "author": { "@type": "Organization", "name": s.legal_name },
  "publisher": { "@type": "Organization", "name": s.legal_name, "logo": { "@type": "ImageObject", "url": s.base_url + "/assets/img/wappen.png" } },
  "mainEntityOfPage": s.base_url + path
}) %>
</script>
</head>
<body>
<%- include('../partials/header') %>
<main>
<article class="seite" style="max-width: 820px">
<div class="news-meta"><span class="tag<%= post.type === 'kampfbericht' ? ' tag-bericht' : (post.type === 'verein' ? ' tag-verein' : '') %>"><%= util.POST_TYPES[post.type] || post.type %></span><time class="muted" datetime="<%= post.date %>"><%= util.formatDate(post.date) %></time></div>
<h1 style="font-size: clamp(40px, 5.5vw, 64px)"><%= post.title %></h1>
<% if (post.image) { %><img src="<%= post.image %>" alt="<%= post.image_alt %>" style="width: 100%; border: 2px solid #0B1B4A"><% } %>
<div style="font-size: 19px; display: flex; flex-direction: column; gap: 18px">
<%- util.formatText(post.body) %>
</div>
<% if (more.length) { %>
<div style="border-top: 3px solid #0B1B4A; padding-top: 24px; display: flex; flex-direction: column; gap: 12px">
<span class="eyebrow">Weitere Beiträge</span>
<% for (const m of more) { %><a href="/aktuelles/<%= m.slug %>" style="font-weight: 600"><%= m.title %></a> <span class="small"><%= util.formatDate(m.date) %></span><% } %>
</div>
<% } %>
</article>
</main>
<%- include('../partials/footer') %>
