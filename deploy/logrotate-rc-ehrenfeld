# /etc/logrotate.d/rc-ehrenfeld
# Löscht die Zugriffsprotokolle nach 14 Tagen (passend zur Datenschutzerklärung)
/var/log/nginx/rc-ehrenfeld.*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 $(cat /var/run/nginx.pid)
    endscript
}
